# Auralis Mission Control Environment Variables Template
# Copy this file to .env.local: cp .env.example .env.local

# API Mode: 'mock' (default offline mode) | 'live' (agent backend running at :8000)
NEXT_PUBLIC_API_MODE=mock
AURALIS_PERSISTENCE=false
AURALIS_API_KEY=

# Backend Service URLs (used when NEXT_PUBLIC_API_MODE=live)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Space-Track.org Credentials (optional for live US Space Force CDMs)
SPACE_TRACK_USER=
SPACE_TRACK_PASSWORD=

# Google Gemini API Keys for Autonomous Agent Brains (strictly gemini-2.5-flash with auto-rotation)
GOOGLE_API_KEY_1=
# GOOGLE_API_KEY_2=
# GOOGLE_API_KEY_3=
